{
  "name": "herdr-daytona-sandbox-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent Daytona coding agents for Herdr",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run verify:manifest && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@daytona/sdk": "0.231.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "@iarna/toml": "2.2.5"
  }
}
